# Copy to .env and fill in. Never commit your real .env.
# Discord application: https://discord.com/developers/applications

# --- Required ----------------------------------------------------------------
DISCORD_TOKEN=
CLIENT_ID=
# Set for instant slash-command registration in one server; leave blank for global.
GUILD_ID=
# Your own server(s), comma-separated: cards there leave out "by BajuBesi Labs".
# Blank = falls back to GUILD_ID; every other server shows the credit.
HOME_GUILD_IDS=

LOG_LEVEL=info

# --- Server status -------------------------------------------------------------
# Your AION 2 server name, highlighted on the status panel (e.g. Beritra).
HOME_SERVER_NAME=Beritra
# Character-creation icons. Defaults to 🔒 / 🔓; use custom emojis like <:lock:123456789012345678>.
LOCK_EMOJI=
UNLOCK_EMOJI=

# --- Immortal Gartua ------------------------------------------------------------
# Comma-separated role IDs allowed to use /gartua set and /gartua channel.
# Leave blank and nobody can change the manual timer.
GARTUA_TRUSTED_ROLE_IDS=
GARTUA_ALERT_LEAD_MIN=5
GARTUA_ALERT_KEEP_MIN=60

# --- Steam news / patch notes -----------------------------------------------------
# Channel to post official AION 2 Steam announcements in. Blank disables it.
NEWS_CHANNEL_ID=
# Optional role to ping with each post.
NEWS_ROLE_ID=

# --- Legion roster & role sync (/profile) -----------------------------------------
# Your legion's name exactly as shown in game (matched case-insensitively).
LEGION_NAME=
LEGION_ROLE_ID=
PLAYER_ROLE_ID=
PLAYER_ROLE_NAME=Daevas
# true = legion members also get the player role
PLAYER_ROLE_FOR_LEGION=false

# --- Website (read-only timers page) ---------------------------------------------
# Set false to turn the website off.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8787

# Daeva Meter ping: game servers by server number, scrambled in the feed.
# BERITRA_PROBE_HOST/PORT (see README) covers the Asia servers (Tokyo). Add other
# regions here, separated by ";" (no new meter version needed):
# METER_PING_SERVERS=3001-3020=Seoul@203.0.113.5:13328
METER_PING_SERVERS=
